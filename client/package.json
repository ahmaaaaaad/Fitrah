{
  "name": "fitrah-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "dev:fitrah": "vite --host --config vite.fitrah.config.js --open /fitrah.html",
    "build:fitrah": "vite build --config vite.fitrah.config.js",
    "build:server": "esbuild ../server/fitrah-server.mjs --bundle --platform=node --format=esm --target=node18 --outfile=../server/dist/fitrah-server.mjs --loader:.json=json",
    "serve:prod": "node ../server/dist/fitrah-server.mjs"
  },
  "dependencies": {
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "gsap": "^3.12.5",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "vite": "^5.4.8"
  }
}
